{
  "name": "active-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "bun run generate-routes && bun run typecheck && bun run build",
    "deploy": "bun run check && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/router-cli": "^1.132.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  }
}
