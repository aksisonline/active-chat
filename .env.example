# better-auth Configuration
# Generate a secure random secret: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (via better-auth)
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PartyKit Configuration
# Use your PartyKit project host after deploying: https://active-chat.YOUR_USERNAME.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# App URL (used by better-auth client)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: For Cloudflare KV cache (required when deploying to Cloudflare Workers)
# NEXT_CACHE_WORKERS_KV=your-kv-namespace-id
