{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "active-chat",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "chat-rooms-v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
